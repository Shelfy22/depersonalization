# Required: generate a random secret, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
ANON_API_KEY=replace-with-random-secret
ANON_DEFAULT_PROFILE=rubert
ANON_ENABLE_RUBERT=true
ANON_ENABLE_GLINER=false
ANON_RUBERT_MODEL=redmadrobot-rnd/rubert-base-pii-ner
ANON_RUBERT_REVISION=main
ANON_GLINER_MODEL=urchade/gliner_multi_pii-v1
ANON_GLINER_REVISION=main
# Set revisions to reviewed commit hashes for reproducible deployments.
ANON_LOCAL_FILES_ONLY=true
ANON_DEVICE=cpu
ANON_TORCH_THREADS=4
ANON_MAX_UPLOAD_MB=25
ANON_MAX_DOCUMENT_CHARS=2000000
ANON_MAX_PAGES=500
ANON_QUEUE_SIZE=4
ANON_JOB_TTL_SECONDS=1800
ANON_DICTIONARY_PATH=data/dictionaries.json
HF_HOME=/models
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
